# Vývoj: skopíruj do .env.local. Server (Docker): skopíruj do .env.
# Hodnoty zo Supabase (Project Settings → API).
# Sem patrí iba verejný (publishable/anon) kľúč. Service-role kľúč do frontendu nikdy nepatrí.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Iba na serveri: token Cloudflare tunela (Zero Trust → Networks → Tunnels).
TUNNEL_TOKEN=
